# Server Configuration
PORT=5000

# MongoDB Configuration
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/infinito-comics?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRY_DATE=7d
FORGET_PASSWORD_EXPIRY=15m

# Frontend URLs (CORS)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:3002
RESEARCH_URL=http://localhost:3003
FOUNDATION_URL=http://localhost:3004

# AWS S3 File Storage
ACCESS_KEY=your_aws_access_key
SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=ap-south-1

# Email Configuration
EMAIL_ID=your_email@domain.com
EMAIL_PASS=your_email_password
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465

# Razorpay Payment
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET_KEY=your_razorpay_secret_key
