<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not apply main site rewrites to subdomains
  RewriteCond %{HTTP_HOST} ^admin\.infinitohq\.com$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^research\.infinitohq\.com$ [NC]
  RewriteRule ^ - [L]

  # Do not rewrite requests to /admin/ or /research/ subdirectories
  RewriteCond %{REQUEST_URI} ^/admin [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_URI} ^/research [NC]
  RewriteRule ^ - [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache-busting for React/Vite SPA
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
