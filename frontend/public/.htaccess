Options -MultiViews
RewriteEngine On

# Redirect careers subdomain to /careers route
RewriteCond %{HTTP_HOST} ^careers\.infinitohq\.com$ [NC]
RewriteRule ^(.*)$ https://infinitohq.com/careers/$1 [R=301,L]

# React Router for admin subfolder
RewriteCond %{REQUEST_URI} ^/admin
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /admin/index.html [QSA,L]

# React Router for research subfolder
RewriteCond %{REQUEST_URI} ^/research
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ /research/index.html [QSA,L]

# React Router for main site only
RewriteCond %{REQUEST_URI} !^/admin
RewriteCond %{REQUEST_URI} !^/research
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]
